# Copy to .env for opt-in live model tests. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemma-4-26b-a4b-it

# Optional roster for: python3 tests/live_openrouter.py --models
# Comma separated. Defaults are defined in tests/live_openrouter.py.
# LIVE_MODELS=meta/muse-spark-1.3-contributor,deepseek/deepseek-v4-flash-0731

# Optional path to an already-built binary.
# SHELL_IS_ALL_YOU_NEED_BIN=/absolute/path/to/shell-is-all-you-need
